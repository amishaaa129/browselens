{
  "manifest_version": 3,
  "name": "BrowseLens",
  "version": "1.0.0",
  "description": "Privacy-first browser activity tracker.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BrowseLens dashboard"
  }
}